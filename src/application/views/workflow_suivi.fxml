<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="application.controllers.WorkflowSuiviController"
            style="-fx-background-color: #ecf0f1;"
            minWidth="1400" minHeight="900">
   
   <!-- EN-TÊTE -->
   <top>
      <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 20;">
         
         <!-- Titre principal -->
         <HBox alignment="CENTER" spacing="20" style="-fx-background-color: linear-gradient(to right, #667eea, #764ba2); -fx-padding: 20; -fx-background-radius: 12;">
            <Label text="🚀 Visualisation Dynamique des Flux de Courriers" 
                   style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
         </HBox>
         
         <!-- Sélection mode et filtres -->
         <VBox spacing="10" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-background-radius: 8;">
            
            <HBox spacing="20" alignment="CENTER_LEFT">
               <Label text="Mode:" style="-fx-font-weight: bold;"/>
               <ComboBox fx:id="cbModeVisualisation" prefWidth="300"/>
               
               <Label text="Période:" style="-fx-font-weight: bold;"/>
               <ComboBox fx:id="cbPeriode" prefWidth="200"/>
               
               <DatePicker fx:id="dpDebut" prefWidth="140" disable="true"/>
               <DatePicker fx:id="dpFin" prefWidth="140" disable="true"/>
            </HBox>
            
            <HBox spacing="20" alignment="CENTER_LEFT">
               <Label text="Priorité:" style="-fx-font-weight: bold;"/>
               <ComboBox fx:id="cbPriorite" prefWidth="180"/>
               
               <CheckBox fx:id="chkInclureConfidentiels" text="Inclure confidentiels"/>
               <CheckBox fx:id="chkAfficherStatistiques" text="📊 Statistiques" selected="true"/>
               <CheckBox fx:id="chkAfficherGoulots" text="⚠️ Goulots" selected="true"/>
               
               <Region HBox.hgrow="ALWAYS"/>
               
               <Button fx:id="btnActualiser" text="🔄 Actualiser" 
                      style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 20;"/>
               <Button fx:id="btnExporter" text="📷 Exporter" 
                      style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 20;"/>
            </HBox>
         </VBox>
         
         <!-- Contrôles de zoom -->
         <HBox spacing="15" alignment="CENTER">
            <Label text="🔍 Zoom:" style="-fx-font-weight: bold;"/>
            <Slider fx:id="sliderZoom" prefWidth="200" min="0.25" max="3.0" value="1.0"/>
            <Label fx:id="lblZoomValue" text="100%" style="-fx-min-width: 60; -fx-font-weight: bold;"/>
            <Label fx:id="lblNbCourriers" text="0 courriers" style="-fx-text-fill: #7f8c8d;"/>
            <Label fx:id="lblNbEtapes" text="0 étapes" style="-fx-text-fill: #7f8c8d;"/>
         </HBox>
         
      </VBox>
   </top>
   
   <!-- CONTENU PRINCIPAL -->
   <center>
      <SplitPane dividerPositions="0.65">
         
         <!-- ZONE GRAPHE (65%) -->
         <VBox spacing="10" style="-fx-padding: 15;">
            
            <!-- Légende -->
            <HBox spacing="20" alignment="CENTER" style="-fx-background-color: white; -fx-padding: 10; -fx-background-radius: 8;">
               <HBox spacing="5" alignment="CENTER">
                  <javafx.scene.shape.Circle radius="5" fill="#e67e22"/>
                  <Label text="Entrant" style="-fx-font-weight: bold; -fx-text-fill: #e67e22; -fx-font-size: 10px;"/>
               </HBox>
               <HBox spacing="5" alignment="CENTER">
                  <javafx.scene.shape.Circle radius="5" fill="#3498db"/>
                  <Label text="Sortant" style="-fx-font-weight: bold; -fx-text-fill: #3498db; -fx-font-size: 10px;"/>
               </HBox>
               <HBox spacing="5" alignment="CENTER">
                  <javafx.scene.shape.Circle radius="5" fill="#95a5a6"/>
                  <Label text="Interne" style="-fx-font-weight: bold; -fx-text-fill: #95a5a6; -fx-font-size: 10px;"/>
               </HBox>
            </HBox>
            
            <!-- Zone de dessin avec scroll -->
            <ScrollPane fx:id="graphScrollPane" fitToWidth="false" fitToHeight="false" 
                       pannable="true" VBox.vgrow="ALWAYS"
                       style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-width: 2;">
               <Pane fx:id="graphPane" style="-fx-background-color: #fafafa;" minWidth="2500" minHeight="2000"/>
            </ScrollPane>
            
         </VBox>
         
         <!-- PANNEAU LATÉRAL (35%) -->
         <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 15;">
            
            <TabPane VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE">
               
               <!-- Onglet Courriers -->
               <Tab text="📋 Courriers">
                  <VBox spacing="10" style="-fx-padding: 10;" fx:id="tableauCourriersContainer">
                     
                     <HBox spacing="10">
                        <TextField fx:id="txtRechercherCourrier" promptText="🔍 Rechercher..." 
                                  HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnVoirSelectionne" text="👁" disable="true"/>
                        <Button fx:id="btnCommenterSelectionne" text="💬" disable="true"/>
                     </HBox>
                     
                     <TableView fx:id="tableCourriers" VBox.vgrow="ALWAYS">
                        <columns>
                           <TableColumn fx:id="colCourrierCode" text="Code" prefWidth="100"/>
                           <TableColumn fx:id="colCourrierObjet" text="Objet" prefWidth="180"/>
                           <TableColumn fx:id="colCourrierType" text="Type" prefWidth="80"/>
                           <TableColumn fx:id="colCourrierPriorite" text="Priorité" prefWidth="90"/>
                           <TableColumn fx:id="colCourrierStatut" text="Statut" prefWidth="80"/>
                           <TableColumn fx:id="colCourrierEtapes" text="Étapes" prefWidth="60"/>
                           <TableColumn fx:id="colCourrierDuree" text="Durée" prefWidth="80"/>
                           <TableColumn fx:id="colCourrierActions" text="" prefWidth="100"/>
                        </columns>
                     </TableView>
                     
                  </VBox>
               </Tab>
               
               <!-- Onglet Statistiques -->
               <Tab text="📊 Statistiques">
                  <VBox spacing="10" style="-fx-padding: 10;" fx:id="statsContainer">
                     
                     <!-- Stats principales -->
                     <GridPane hgap="10" vgap="10">
                        <Label text="Total:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
                        <Label fx:id="statTotalCourriers" text="0" GridPane.columnIndex="1" GridPane.rowIndex="0" 
                              style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #3498db;"/>
                        
                        <Label text="Services:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
                        <Label fx:id="statServicesActifs" text="0" GridPane.columnIndex="1" GridPane.rowIndex="1"
                              style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #e67e22;"/>
                        
                        <Label text="Durée moy:" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: bold;"/>
                        <Label fx:id="statDureeMoyenne" text="0h" GridPane.columnIndex="1" GridPane.rowIndex="2"
                              style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
                        
                        <Label text="Goulots:" GridPane.columnIndex="0" GridPane.rowIndex="3" style="-fx-font-weight: bold;"/>
                        <Label fx:id="statGoulotsDetectes" text="0" GridPane.columnIndex="1" GridPane.rowIndex="3"
                              style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;"/>
                        
                        <Label text="Taux réussite:" GridPane.columnIndex="0" GridPane.rowIndex="4" style="-fx-font-weight: bold;"/>
                        <Label fx:id="statTauxReussite" text="0%" GridPane.columnIndex="1" GridPane.rowIndex="4"
                              style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #9b59b6;"/>
                        
                        <Label text="Retards:" GridPane.columnIndex="0" GridPane.rowIndex="5" style="-fx-font-weight: bold;"/>
                        <Label fx:id="statRetards" text="0" GridPane.columnIndex="1" GridPane.rowIndex="5"
                              style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;"/>
                     </GridPane>
                     
                     <Separator/>
                     
                     <!-- Tabs détaillés -->
                     <TabPane fx:id="statsTabPane" VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE">
                        <Tab fx:id="tabStatsGlobales" text="Global">
                           <ScrollPane fitToWidth="true">
                              <VBox fx:id="statsGlobalesContent" spacing="10" style="-fx-padding: 10;"/>
                           </ScrollPane>
                        </Tab>
                        <Tab fx:id="tabStatsServices" text="Services">
                           <ScrollPane fitToWidth="true">
                              <VBox fx:id="statsServicesContent" spacing="10" style="-fx-padding: 10;"/>
                           </ScrollPane>
                        </Tab>
                        <Tab fx:id="tabStatsTemporelles" text="Temporel">
                           <ScrollPane fitToWidth="true">
                              <VBox fx:id="statsTemporellesContent" spacing="10" style="-fx-padding: 10;"/>
                           </ScrollPane>
                        </Tab>
                     </TabPane>
                     
                  </VBox>
               </Tab>
               
            </TabPane>
            
         </VBox>
         
      </SplitPane>
   </center>
   
   <!-- BARRE DE STATUS -->
   <bottom>
      <HBox alignment="CENTER_LEFT" spacing="15" 
           style="-fx-background-color: #2c3e50; -fx-padding: 10 20;">
         <Label text="✨ Prêt" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
         <Separator orientation="VERTICAL"/>
         <Label text="Mode: Collective" style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 11px;"/>
      </HBox>
   </bottom>
   
</BorderPane>
